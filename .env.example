# Local development configuration.
# Copy this file to .env before running Docker Compose. Never commit .env.
# The values below are safe local-only defaults, not production credentials.

POSTGRES_DB=devpulse
POSTGRES_USER=devpulse
POSTGRES_PASSWORD=devpulse_local_password
POSTGRES_PORT=5432

REDIS_PASSWORD=devpulse_local_redis_password
REDIS_PORT=6379

# Connection strings for future applications running on the host.
# Update these if you change the credentials or ports above.
DATABASE_URL=postgresql://devpulse:devpulse_local_password@localhost:5432/devpulse?schema=public
REDIS_URL=redis://:devpulse_local_redis_password@localhost:6379/0
